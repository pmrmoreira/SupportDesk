@page
@model IndexModel
@{
    ViewData["Title"] = "SupportDesk AI";
}

<div class="text-center mb-4">
    <h1 class="display-4">SupportDesk AI</h1>
    <p class="lead">Gestão de pedidos de suporte com assistência de IA.</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <p><a asp-page="/Account/Login">Entra</a> ou <a asp-page="/Account/Register">cria uma conta</a> para veres os teus pedidos.</p>
    }
</div>

<div class="row g-3">
    @foreach (var (status, total) in Model.Counts)
    {
        <div class="col-sm-4">
            <a asp-page="/Tickets/Index" asp-route-status="@status" class="card h-100 text-decoration-none text-body">
                <div class="card-body">
                    <div class="text-muted">@DisplayFormat.Status(status)</div>
                    <div class="display-6">@total</div>
                </div>
            </a>
        </div>
    }
</div>
