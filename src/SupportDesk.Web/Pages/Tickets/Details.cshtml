@page "{id:int}"
@model SupportDesk.Web.Pages.Tickets.DetailsModel
@{
    ViewData["Title"] = $"Pedido {Model.Ticket.Id}";
}

<p><a asp-page="./Index">← Pedidos</a></p>

<h1>@Model.Ticket.Title</h1>
<p>
    <partial name="_StatusBadge" model="Model.Ticket.Status" />
    <span class="ms-2">Prioridade @DisplayFormat.Priority(Model.Ticket.Priority)</span>
    <span class="ms-2">Categoria @(Model.Ticket.Category is { } category ? DisplayFormat.Category(category) : "por definir")</span>
    <span class="ms-2 text-muted">Criado a @DisplayFormat.DateTime(Model.Ticket.CreatedAt)
        @(Model.Ticket.CreatedByName is null ? "" : $"por {Model.Ticket.CreatedByName}")</span>
</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (Model.CanEdit && Model.Ticket.Status != TicketStatus.Resolved)
    {
        <a asp-page="./Edit" asp-route-id="@Model.Ticket.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
    }
    @* Aula 10, ciclo 3: sem CanChangeStatus a lista é vazia. Esconder poupa cliques; quem protege é o servidor. *@
    @foreach (var next in Model.CanChangeStatus ? TicketWorkflow.NextStatuses(Model.Ticket.Status) : [])
    {
        <form method="post" asp-page-handler="Status" asp-route-id="@Model.Ticket.Id">
            <input type="hidden" name="status" value="@next" />
            <button type="submit" class="btn btn-outline-primary btn-sm">@DisplayFormat.Transition(Model.Ticket.Status, next)</button>
        </form>
    }
</div>

@* Aula 15, ciclo 2: a sugestão da IA, só para técnicos. Pedir uma sugestão não muda o pedido. *@
@if (Model.CanClassify)
{
    <div class="card mb-3 col-lg-8">
        <div class="card-body">
            <h2 class="h6">Sugestão da IA</h2>
            @if (Model.Suggestion is { } suggestion)
            {
                <p class="mb-1"><strong>@DisplayFormat.Category(suggestion.Category)</strong> · prioridade @DisplayFormat.Priority(suggestion.Priority)</p>
                <p class="mb-1">@suggestion.Summary</p>
                <p class="small text-muted">@suggestion.Model · @suggestion.InputTokens + @suggestion.OutputTokens tokens · @suggestion.DurationMs ms · @DisplayFormat.DateTime(suggestion.CreatedAt)</p>
                @if (suggestion.Decision == SuggestionDecision.Pending)
                {
                    <div class="d-flex gap-2 mb-2">
                        <form method="post" asp-page-handler="Decide" asp-route-id="@Model.Ticket.Id">
                            <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                            <input type="hidden" name="accept" value="true" />
                            <button type="submit" class="btn btn-success btn-sm">Aceitar</button>
                        </form>
                        <form method="post" asp-page-handler="Decide" asp-route-id="@Model.Ticket.Id">
                            <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                            <input type="hidden" name="accept" value="false" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Rejeitar</button>
                        </form>
                    </div>
                }
                else
                {
                    <p class="small">@(suggestion.Decision == SuggestionDecision.Accepted ? "Aceite" : "Rejeitada") por @suggestion.DecidedByName em @DisplayFormat.DateTime(suggestion.DecidedAt!.Value).</p>
                }
            }
            else
            {
                <p class="small text-muted">Ainda não há sugestões para este pedido.</p>
            }
            <form method="post" asp-page-handler="Suggest" asp-route-id="@Model.Ticket.Id">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Pedir sugestão à IA</button>
            </form>
        </div>
    </div>
}

@* Aula 19: o rascunho de resposta com fontes tem página própria. *@
@if (Model.CanDraftReply)
{
    <p><a asp-page="./Reply" asp-route-id="@Model.Ticket.Id" class="btn btn-outline-primary btn-sm">Rascunho de resposta (IA)</a></p>
}

@* Aula 16: o resumo da conversa (IA), só para técnicos. Abrir o pedido lê a base; só o botão chama o modelo. *@
@if (Model.CanSummarize)
{
    <div class="card mb-3 col-lg-8">
        <div class="card-body">
            <h2 class="h6">Resumo da conversa (IA)</h2>
            @if (Model.Summary is { } summary)
            {
                @if (Model.IsSummaryStale)
                {
                    <div class="alert alert-info py-1 small" role="status">O pedido mudou depois deste resumo.</div>
                }
                <p class="mb-1">@summary.Problem</p>
                @if (summary.ActionsTaken.Count > 0)
                {
                    <p class="small mb-0"><strong>Já feito:</strong></p>
                    <ul class="small">
                        @foreach (var action in summary.ActionsTaken)
                        {
                            <li>@action</li>
                        }
                    </ul>
                }
                @if (summary.MissingInformation.Count > 0)
                {
                    <p class="small mb-0"><strong>Falta saber:</strong></p>
                    <ul class="small">
                        @foreach (var missing in summary.MissingInformation)
                        {
                            <li>@missing</li>
                        }
                    </ul>
                }
                <p class="small text-muted">
                    @summary.Model · @summary.InputTokens + @summary.OutputTokens tokens · @summary.DurationMs ms ·
                    @summary.IncludedComments comentários@(summary.OmittedComments > 0 ? $" ({summary.OmittedComments} omitidos)" : "") ·
                    @DisplayFormat.DateTime(summary.CreatedAt)
                </p>
            }
            else
            {
                <p class="small text-muted">Ainda não há resumo desta conversa.</p>
            }
            <div class="d-flex flex-wrap gap-2">
                <form method="post" asp-page-handler="Summarize" asp-route-id="@Model.Ticket.Id">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">@(Model.Summary is null ? "Resumir conversa" : "Resumir outra vez")</button>
                </form>
                @* Exercício A: só aparece quando há resumo. *@
                @if (Model.Summary is not null)
                {
                    <form method="post" asp-page-handler="SaveSummary" asp-route-id="@Model.Ticket.Id">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Guardar como comentário</button>
                    </form>
                }
            </div>
        </div>
    </div>
}

@if (string.IsNullOrWhiteSpace(Model.Ticket.Description))
{
    <p class="text-muted">Sem descrição.</p>
}
else
{
    <p style="white-space: pre-line">@Model.Ticket.Description</p>
}

<h2 class="h4 mt-4">Comentários (@Model.Comments.Length)</h2>

@if (Model.Comments.Length == 0)
{
    <p class="text-muted">Ainda não há comentários.</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var comment in Model.Comments)
        {
            var system = comment.Author == "Sistema";
            <li class="border rounded p-2 mb-2 @(system ? "bg-light text-muted small" : "")">
                <strong>@comment.Author</strong>
                <span class="text-muted small">· @DisplayFormat.DateTime(comment.CreatedAt)</span>
                <div style="white-space: pre-line">@comment.Text</div>
            </li>
        }
    </ul>
}

<h2 class="h5 mt-4">Novo comentário</h2>
<form method="post" asp-page-handler="Comment" asp-route-id="@Model.Ticket.Id" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="NewComment.Text" class="form-label">Comentário</label>
        <textarea asp-for="NewComment.Text" class="form-control" rows="3"></textarea>
        <span asp-validation-for="NewComment.Text" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Comentar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
