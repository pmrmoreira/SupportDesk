@page "{id:int}"
@model SupportDesk.Web.Pages.Tickets.DetailsModel
@{
    ViewData["Title"] = $"Pedido {Model.Ticket.Id}";
}

<p><a asp-page="./Index">← Pedidos</a></p>

<h1>@Model.Ticket.Title</h1>
<p>
    <partial name="_StatusBadge" model="Model.Ticket.Status" />
    <span class="ms-2">Prioridade @DisplayFormat.Priority(Model.Ticket.Priority)</span>
    <span class="ms-2 text-muted">Criado a @DisplayFormat.DateTime(Model.Ticket.CreatedAt)
        @(Model.Ticket.CreatedByName is null ? "" : $"por {Model.Ticket.CreatedByName}")</span>
</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (Model.CanEdit && Model.Ticket.Status != TicketStatus.Resolved)
    {
        <a asp-page="./Edit" asp-route-id="@Model.Ticket.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
    }
    @* Aula 10, ciclo 3: sem CanChangeStatus a lista é vazia. Esconder poupa cliques; quem protege é o servidor. *@
    @foreach (var next in Model.CanChangeStatus ? TicketWorkflow.NextStatuses(Model.Ticket.Status) : [])
    {
        <form method="post" asp-page-handler="Status" asp-route-id="@Model.Ticket.Id">
            <input type="hidden" name="status" value="@next" />
            <button type="submit" class="btn btn-outline-primary btn-sm">@DisplayFormat.Transition(Model.Ticket.Status, next)</button>
        </form>
    }
</div>

@if (string.IsNullOrWhiteSpace(Model.Ticket.Description))
{
    <p class="text-muted">Sem descrição.</p>
}
else
{
    <p style="white-space: pre-line">@Model.Ticket.Description</p>
}

<h2 class="h4 mt-4">Comentários (@Model.Comments.Length)</h2>

@if (Model.Comments.Length == 0)
{
    <p class="text-muted">Ainda não há comentários.</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var comment in Model.Comments)
        {
            var system = comment.Author == "Sistema";
            <li class="border rounded p-2 mb-2 @(system ? "bg-light text-muted small" : "")">
                <strong>@comment.Author</strong>
                <span class="text-muted small">· @DisplayFormat.DateTime(comment.CreatedAt)</span>
                <div style="white-space: pre-line">@comment.Text</div>
            </li>
        }
    </ul>
}

<h2 class="h5 mt-4">Novo comentário</h2>
<form method="post" asp-page-handler="Comment" asp-route-id="@Model.Ticket.Id" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="NewComment.Text" class="form-label">Comentário</label>
        <textarea asp-for="NewComment.Text" class="form-control" rows="3"></textarea>
        <span asp-validation-for="NewComment.Text" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Comentar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
