@if (User.Identity?.IsAuthenticated == true)
{
    <span class="navbar-text me-2">@User.Identity.Name</span>
    <form method="post" asp-page="/Account/Logout" class="d-inline">
        <button type="submit" class="btn btn-link nav-link d-inline px-0">Sair</button>
    </form>
}
else
{
    <a class="nav-link text-dark d-inline me-2" asp-page="/Account/Login">Entrar</a>
    <a class="nav-link text-dark d-inline" asp-page="/Account/Register">Criar conta</a>
}
