@page
@model SupportDesk.Web.Pages.Ai.ClassifyModel
@{
    ViewData["Title"] = "Classificar texto";
}

<h1>Classificar texto</h1>
<p class="text-muted">Experimenta o classificador sem gravar nada. <a asp-page="./Lab">Voltar ao laboratório</a></p>

<form method="post" class="col-lg-8">
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label">Título</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label">Descrição</label>
        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Classificar</button>
</form>

@if (Model.Result is { } result)
{
    <div class="card mt-4 col-lg-8">
        <div class="card-body">
            @if (result.Classification is { } c)
            {
                <p class="mb-1"><strong>@DisplayFormat.Category(c.Category)</strong> · prioridade @DisplayFormat.Priority(c.Priority)</p>
                <p class="mb-2">@c.Summary</p>
            }
            else
            {
                <div class="alert alert-warning" role="alert">@result.Error</div>
            }
            @if (result.RawText is not null)
            {
                <p class="small mb-1">Resposta do modelo, tal como chegou:</p>
                <pre class="small bg-light p-2">@result.RawText</pre>
            }
            <p class="small text-muted mb-0">@result.Model · @result.InputTokens + @result.OutputTokens tokens · @((int)result.Elapsed.TotalMilliseconds) ms</p>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
